{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["functions", "shared"],
  // I test di shared/ restano fuori: li compila gia' `tsc -b` col resto
  // dell'app. Tenerli qui legherebbe il build alla presenza di `vitest` tra
  // i moduli installati, e questo controllo ora blocca il deploy.
  "exclude": ["**/*.test.ts"]
}
